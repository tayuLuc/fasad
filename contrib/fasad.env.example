# fasad: пример файла конфигурации (#292, контур #219/#224).
#
# Куда положить (файл читается демоном АВТОМАТОМ, env не нужен):
#   unix/mac: ${XDG_CONFIG_HOME:-~/.config}/fasad/config
#   windows:  %APPDATA%\fasad\config
#   linux-юнит (contrib/systemd/fasad.service): /etc/default/fasad
# Явный путь = FASAD_CONFIG в окружении (файла по нему нет = отказ старта,
# #185-контур: опечатка в пути обязана быть названа).
#
# Формат: КЛЮЧ=значение, строки `#` и пустые игнорируются.
# Приоритет: env > файл (#224); UI-правка = POST /v1/config = ЗАПИСЬ в этот
# же файл (hot-reload нет: «Перезапусти» в UI), значений ниже не перебивает;
# значения проходят те же валидаторы,
# что env (второй грамматики нет); неизвестный ключ = предупреждение в лог,
# не отказ.
#
# СЕКРЕТЫ В ФАЙЛЕ ЗАПРЕЩЕНЫ (fail-closed, конфиг краснеет на старте):
# FASAD_VAULT_KEY — только переменная окружения (AGENTS: никаких секретов
# на диске в открытом виде); FASAD_BIND, FASAD_MLOCK, FASAD_CONFIG — тоже
# env-контур (политика развёртывания).
#
# Все строки ниже закомментированы = дефолты демона. Раскомментируй нужное.

## Модель (каскады 1–2)
#FASAD_MODEL_DIR=
#FASAD_HF_HOST=
#FASAD_SCHEMA=
#FASAD_THREADS=2
#FASAD_TIMEOUT_MS=1500

## HTTP (loopback-инвариант: порт, не адрес)
#FASAD_PORT=8765
#FASAD_READ_TIMEOUT_MS=30000
#FASAD_MOUNT_POLL_MS=4000
#FASAD_MAX_BODY_BYTES=1048576

## Хранилище масок (ключ шифрования = ТОЛЬКО env, см. шапку)
#FASAD_VAULT_MODE=session

## Пороги каскадов (серая зона, арбитр; первичка docs/daemon-scope.md)
#FASAD_GRAY_LO=0.22
#FASAD_GRAY_HI=0.85
#FASAD_TAU_LOW=0.2
#FASAD_TAU_HIGH=0.9
#FASAD_ARBITER_ALPHA=0.5
#FASAD_FRAME_MIN=0.95
#FASAD_TRANSLIT=1

## Прокси
#FASAD_UPSTREAM_ALLOWLIST=
#FASAD_PROXY_LOOPBACK_HTTP=0
